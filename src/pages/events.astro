---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>Events | CSI CVRCE</title>

  <meta
    name="description"
    content="Explore workshops, hackathons, technical events and other activities conducted by CSI CVRCE."
  />
</head>

<body>

<header class="navbar">
  <div class="nav-container">

    <a href="/" class="brand">

      <img
        src="/images/cvrlogo.png"
        alt="CVR College of Engineering Logo"
        class="cvr-logo"
      />

      <span class="divider"></span>

      <img
        src="/images/csicvrlogo.png"
        alt="CSI Logo"
        class="csi-logo"
      />

    </a>

    <nav class="desktop-nav">
      <a href="/">Home</a>
      <a href="/aboutus">About Us</a>
      <a href="/events" class="active-nav">Events</a>
      <a href="/gallery">Gallery</a>
      <a href="/team">Team</a>
      <a href="/blog">Blog</a>
    </nav>

    <a href="/join-us" class="nav-button">
      Join Us
    </a>

    <button class="mobile-menu">
      ☰
    </button>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/">Home</a>
      <a href="/aboutus">About Us</a>
      <a href="/events">Events</a>
      <a href="/blog">Blog</a>
      <a href="/gallery">Gallery</a>
      <a href="/team">Team</a>
      <a href="/blog">Blog</a>
      <a href="/join-us">Join Us</a>
    </nav>

  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLButtonElement>('.mobile-menu');
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

  mobileMenu?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open') ?? false;
    mobileMenu.setAttribute('aria-expanded', String(isOpen));
    mobileMenu.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileNav.classList.remove('is-open'));
  });
</script>


<!-- HERO -->

<section class="events-hero">

  <div>

    <div class="hero-badge">
      <span></span>
      CSI CVRCE
    </div>

    <h1>
      Events &
      <span>Experiences.</span>
    </h1>

    <p>
      Workshops, hackathons, contests and technical
      experiences designed to help students learn,
      build and grow.
    </p>

  </div>

  <div class="events-count">
    <strong>{orderedEvents.length}+</strong>
    <span>Recorded Events</span>
  </div>

</section>


<!-- UPCOMING -->

<section class="upcoming section">

  <div class="section-label">
    <span>01</span>
    WHAT'S NEXT
  </div>

  <div class="upcoming-card">

    <div>
      <span class="upcoming-status">
        ● COMING SOON
      </span>

      <h2>
        No upcoming
        <span>events.</span>
      </h2>

      <p>
        Check back later for new technical events,
        workshops and competitions.
      </p>
    </div>

    <div class="upcoming-symbol">
      +
    </div>

  </div>

</section>


<!-- PAST EVENTS -->

<section class="past-events section">

  <div class="section-top">

    <div>

      <div class="section-label">
        <span>02</span>
        ARCHIVE
      </div>

      <h2>
        Past
        <span>Events.</span>
      </h2>

    </div>

    <p>
      Explore our technical journey through
      the years.
    </p>

  </div>


  <!-- FILTER -->

  <div class="event-filters">

    <button class="filter active" data-year="all">
      All Years
    </button>

    <button class="filter" data-year="2026-2027">
      2026–2027
    </button>

    <button class="filter" data-year="2025-2026">
      2025–2026
    </button>

    <button class="filter" data-year="2024-2025">
      2024–2025
    </button>

    <button class="filter" data-year="2023-2024">
      2023–2024
    </button>

  </div>


  <!-- EVENT GRID -->

  <div class="event-grid">

    {orderedEvents.map((event, index) => (

      <article
        class="event-card"
        data-year={event.year}
      >

        <div class="event-image">

          {event.image ? (
            <img
              src={event.image.src}
              alt={event.title}
              loading={index < 6 ? "eager" : "lazy"}
              decoding="async"
            />
          ) : (
            <div class="no-poster">
              <span>CSI</span>
            </div>
          )}

          <span class="event-type">
            {event.type}
          </span>

        </div>


        <div class="event-info">

          <div class="event-date">
            {event.date}
          </div>

          <h3>
            {event.title}
          </h3>

          <div class="event-bottom">

            <span>
              {event.year}
            </span>

            {event.slug && event.galleryImages?.length ? (
              <a
                href={`/events/${event.slug}`}
                class="event-arrow"
                aria-label={`Open gallery for ${event.title}`}
                title="View event gallery"
              >
                <span>View gallery</span>
                <strong aria-hidden="true">↗</strong>
              </a>
            ) : (
              <span class="event-arrow" aria-hidden="true">
                <strong aria-hidden="true">↗</strong>
              </span>
            )}

          </div>

        </div>

      </article>

    ))}

  </div>

</section>


<!-- FOOTER -->

<footer>

  <div class="footer-main">

    <div class="footer-brand">

      <div class="footer-logos">

        <img
          src="/images/cvrlogo.png"
          alt="CVR College of Engineering"
        />

        <img
          src="/images/csicvrlogo.png"
          alt="CSI"
        />

      </div>

      <h3>CSI CVRCE</h3>

      <p>
        Computer Society of India - CVRCE Student Chapter
        is committed to the advancement of theory and practice
        of Computer Engineering and Technology Systems.
      </p>

      <div class="socials">

        <a
          href="https://www.instagram.com/csi_cvr/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>

        <a
          href="https://www.linkedin.com/company/csi-cvrce/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>

        <a
          href="https://github.com/csi-cvrce"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>

      </div>

    </div>


    <div class="footer-column">

      <h4>Quick Links</h4>

      <a href="/">Home</a>
      <a href="/aboutus">About Us</a>
      <a href="/events">Events</a>
      <a href="/gallery">Gallery</a>
      <a href="/team">Team</a>
      <a href="/join-us">Join Us</a>

    </div>


    <div class="footer-column">

      <h4>Contact Us</h4>

      <a
        href="https://maps.app.goo.gl/4uJSrhRj8UF7CsR88"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ibrahimpatnam (Mandal), Pocharam Rd, Vastunagar, Mangalpalli (Village), Telangana 501510
      </a>

      <a href="mailto:csicvrce@gmail.com">
        csicvrce@gmail.com
      </a>

    </div>

  </div>


  <div class="footer-bottom">

    <span>
      © {new Date().getFullYear()} CSI CVRCE
    </span>

    <span>
      Built with purpose.
    </span>

  </div>

</footer>


<script>
  const filters =
    document.querySelectorAll(".filter");

  const cards =
    document.querySelectorAll(".event-card");

  filters.forEach((filter) => {

    filter.addEventListener("click", () => {

      const year =
        filter.getAttribute("data-year");

      filters.forEach((item) => {
        item.classList.remove("active");
      });

      filter.classList.add("active");

      cards.forEach((card) => {

        const cardYear =
          card.getAttribute("data-year");

        if (year === "all" || cardYear === year) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }

      });

    });

  });
</script>

</body>
</html>
