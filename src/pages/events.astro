      />

      <span class="divider"></span>

      <img
        src="/images/csicvrlogo.png"
        alt="CSI Logo"
        class="csi-logo"
      />

    </a>

    <nav class="desktop-nav">
      <a href="/">Home</a>
      <a href="/aboutus">About Us</a>
      <a href="/events" class="active-nav">Events</a>
      <a href="/gallery">Gallery</a>
      <a href="/team">Team</a>
      <a href="/vjh">VJH 2k25</a>
      <a href="/magazines">Magazines</a>
    </nav>

    <a href="/join-us" class="nav-button">
      Join Us
    </a>

    <button class="mobile-menu">
      ☰
    </button>

  </div>
</header>


<!-- HERO -->

<section class="events-hero">

  <div>

    <div class="hero-badge">
      <span></span>
      CSI CVRCE
    </div>

    <h1>
      Events &
      <span>Experiences.</span>
    </h1>

    <p>
      Workshops, hackathons, contests and technical
      experiences designed to help students learn,
      build and grow.
    </p>

  </div>

  <div class="events-count">
    <strong>{events.length}+</strong>
    <span>Recorded Events</span>
  </div>

</section>


<!-- UPCOMING -->

<section class="upcoming section">

  <div class="section-label">
    <span>01</span>
    WHAT'S NEXT
  </div>

  <div class="upcoming-card">

    <div>
      <span class="upcoming-status">
        ● COMING SOON
      </span>

      <h2>
        No upcoming
        <span>events.</span>
      </h2>

      <p>
        Check back later for new technical events,
        workshops and competitions.
      </p>
    </div>

    <div class="upcoming-symbol">
      +
    </div>

  </div>

</section>


<!-- PAST EVENTS -->

<section class="past-events section">

  <div class="section-top">

    <div>

      <div class="section-label">
        <span>02</span>
        ARCHIVE
      </div>

      <h2>
        Past
        <span>Events.</span>
      </h2>

    </div>

    <p>
      Explore our technical journey through
      the years.
    </p>

  </div>


  <!-- FILTER -->

  <div class="event-filters">

    <button class="filter active" data-year="all">
      All Years
    </button>

    <button class="filter" data-year="2026-2027">
      2026–2027
    </button>

    <button class="filter" data-year="2025-2026">
      2025–2026
    </button>

    <button class="filter" data-year="2024-2025">
      2024–2025
    </button>

    <button class="filter" data-year="2023-2024">
      2023–2024
    </button>

    <button class="filter" data-year="2022-2023">
      2022–2023
    </button>

    <button class="filter" data-year="2021-2022">
      2021–2022
    </button>

  </div>


  <!-- EVENT GRID -->

  <div class="event-grid">

    {events.map((event, index) => (

      <article
        class="event-card"
        data-year={event.year}
      >

        <div class="event-image">

          {event.image ? (
            <img
              src={event.image}
              alt={event.title}
              loading={index < 6 ? "eager" : "lazy"}
              decoding="async"
            />
          ) : (
            <div class="no-poster">
              <span>CSI</span>
            </div>
          )}

          <span class="event-type">
            {event.type}
          </span>

        </div>


        <div class="event-info">

          <div class="event-date">
            {event.date}
          </div>

          <h3>
            {event.title}
          </h3>

          <div class="event-bottom">

            <span>
              {event.year}
            </span>

            <span class="event-arrow">
              ↗
            </span>

          </div>

        </div>

      </article>

    ))}

  </div>

</section>


<!-- FOOTER -->

<footer>

  <div class="footer-main">

    <div class="footer-brand">

      <div class="footer-logos">

        <img
          src="/images/cvrlogo.png"
