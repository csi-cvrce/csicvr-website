<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>Events | CSI CVRCE</title>

  <meta
    name="description"
    content="Explore workshops, hackathons, technical events and other activities conducted by CSI CVRCE."
  />
</head>

<body>

<header class="navbar">
  <div class="nav-container">

    <a href="/" class="brand">

