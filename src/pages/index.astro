---
import "../styles/global.css";

const navLinks = [
  { name: "Home", href: "/" },
  { name: "About Us", href: "/aboutus" },
  { name: "Events", href: "/events" },
  { name: "Gallery", href: "/gallery" },
  { name: "Team", href: "/team" },
  { name: "Blog", href: "/blog" },
];

const cards = [
  {
    title: "Events",
    description: "Upcoming and conducted technical events, workshops and hackathons.",
    link: "/events",
    number: "01",
  },
  {
    title: "Blog",
    description: "Stay updated with our technical articles, achievements and monthly digest.",
    link: "/blog",
    number: "02",
  },
  {
    title: "Join Us",
    description: "Become a member of our growing community of technology enthusiasts.",
    link: "/join-us",
    number: "03",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>CSI CVRCE | Computer Society of India</title>

    <meta
      name="description"
      content="Computer Society of India - CVRCE Student Chapter. Learn, innovate and connect with technology professionals."
    />

    <meta
      name="google-site-verification"
      content="ZLgDqaxcCGTXBGLJ7JGu6W1ify9ech0Y_L66LaRuV4Q"
    />

    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <!-- NAVBAR -->
    <header class="navbar">
      <div class="nav-container">

        <a href="/" class="brand">
          <img
            src="/images/cvrlogo.png"
            alt="CVRCE Logo"
            class="cvr-logo"
          />

          <span class="divider"></span>

          <img
            src="/images/csicvrlogo.png"            
            alt="CSI Logo"
            class="csi-logo"
          />
        </a>

        <nav class="desktop-nav">
          {navLinks.map((link) => (
            <a href={link.href}>{link.name}</a>
          ))}
        </nav>

        <a href="/join-us" class="nav-button">
          Join Us
        </a>

        <button class="mobile-menu" aria-label="Open menu">
          ☰
        </button>

        <nav class="mobile-nav" aria-label="Mobile navigation">
          {navLinks.map((link) => (
            <a href={link.href}>{link.name}</a>
          ))}
          <a href="/join-us">Join Us</a>
        </nav>
      </div>
    </header>

    <script>
      const mobileMenu = document.querySelector<HTMLButtonElement>('.mobile-menu');
      const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

      mobileMenu?.addEventListener('click', () => {
        const isOpen = mobileNav?.classList.toggle('is-open') ?? false;
        mobileMenu.setAttribute('aria-expanded', String(isOpen));
        mobileMenu.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      });

      mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileNav.classList.remove('is-open'));
      });
    </script>


    <!-- HERO -->
    <main>

      <section class="hero">

        <div class="hero-glow"></div>

        <div class="hero-content">

          <div class="hero-badge">
            <span></span>
            CSI CVRCE STUDENT CHAPTER
          </div>

          <h1>
            Computer
            <span>Society</span>
            of India
          </h1>

          <p>
            Elevate your tech journey — learn, innovate, and connect
            with like-minded professionals.
          </p>

          <div class="hero-buttons">
            <a href="/join-us" class="primary-button">
              Join Us
              <span>↗</span>
            </a>

            <a href="/aboutus" class="secondary-button">
              Learn More
            </a>
          </div>

        </div>

        <div class="hero-logo">
          <div class="logo-circle">
            <img
              src="/images/csicvrlogo.png"
              alt="CSI CVRCE"
            />
          </div>

          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
        </div>

      </section>


      <!-- INTRO -->
      <section class="intro section">

        <div class="section-label">
          <span>01</span>
          WHO WE ARE
        </div>

        <div class="intro-grid">

          <div>
            <h2>
              CSI
              <span>CVRCE</span>
            </h2>

            <p class="large-text">
              Empowering technology professionals
              <strong>  since 2015.</strong>
            </p>
          </div>

          <div class="intro-text">
            <p>
              Computer Society of India - CVRCE Student Chapter
              is committed to the advancement of theory and practice
              of Computer Engineering and Technology Systems.
            </p>

            <a href="/aboutus" class="text-link">
              Discover our story
              <span>→</span>
            </a>
          </div>

        </div>
      </section>


      <!-- MISSION -->
      <section class="mission section">

        <div class="section-label">
          <span>02</span>
          OUR MISSION
        </div>

        <div class="mission-grid">

          <div class="mission-heading">
            <h2>
              Building the
              <span>next generation.</span>
            </h2>
          </div>

          <div class="mission-content">

            <p>
              To provide a dynamic, innovative, and flexible curriculum
              that equips students with problem-solving skills to
              strengthen their career prospects.
            </p>

            <p>
              To foster inquisitive-driven research among students
              and staff, reinforcing domain knowledge while addressing
              societal issues.
            </p>

            <p>
              To inculcate ethical values, leadership qualities,
              and professional behavior for improving global
              living standards.
            </p>

          </div>

        </div>
      </section>


      <!-- CARDS -->
      <section class="services section">

        <div class="section-top">

          <div>
            <div class="section-label">
              <span>03</span>
              EXPLORE
            </div>

            <h2>
              Something for
              <span>everyone.</span>
            </h2>
          </div>

          <p>
            Learn. Build. Collaborate. Grow.
          </p>

        </div>


        <div class="cards">

          {cards.map((card) => (
            <a href={card.link} class="feature-card">

              <div class="card-number">
                {card.number}
              </div>

              <div class="card-content">
                <h3>{card.title}</h3>

                <p>
                  {card.description}
                </p>
              </div>

              <div class="card-arrow">
                ↗
              </div>

            </a>
          ))}

        </div>

      </section>


      <!-- QUOTE -->
      <section class="quote-section">

        <div class="quote-mark">
          “
        </div>

        <blockquote>
          CSI provides a great platform for learning beyond
          the classroom through workshops, hackathons, and
          technical events. It helps members stay updated with
          industry trends and enhances their problem-solving skills.
        </blockquote>

        <div class="quote-mark quote-mark-end">
          ”
        </div>
          
        <div class="quote-author">
          <div class="author-line"></div>

          <div>
            <strong>Dr. A. Vani Vathsala</strong>
            <span>HOD, CSE Department</span>
          </div>
        </div>

      </section>


      <!-- CTA -->
      <section class="cta section">

        <div class="cta-inner">

          <div>
            <div class="section-label">
              <span>04</span>
              GET INVOLVED
            </div>

            <h2>
              Your next idea
              <span>starts here.</span>
            </h2>

            <p>
              Join a community of students who are curious,
              creative and ready to build the future.
            </p>
          </div>

          <a href="/join-us" class="cta-button">
            Join CSI
            <span>↗</span>
          </a>

        </div>

      </section>

    </main>


    <!-- FOOTER -->
    <footer>

      <div class="footer-main">

        <div class="footer-brand">

          <div class="footer-logos">

            <img
              src="/images/cvrlogo.png"
              alt="CVRCE"
            />

            <img
              src="/images/csicvrlogo.png"
              alt="CSI"
            />

          </div>

          <h3>CSI CVRCE</h3>

          <p>
            Computer Society of India - CVRCE Student Chapter
            is committed to advancing computer engineering and
            technology systems.
          </p>

          <div class="socials">

            <a
              href="https://www.instagram.com/csi_cvr/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>

            <a
              href="https://www.linkedin.com/company/csi-cvrce/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>

            <a
              href="https://github.com/csi-cvrce"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>

          </div>

        </div>


        <div class="footer-column">

          <h4>Quick Links</h4>

          <a href="/aboutus">About Us</a>
          <a href="/events">Events</a>
          <a href="/blog">Blog</a>
          <a href="/team">Team</a>
          <a href="/gallery">Gallery</a>
          <a href="/join-us">Join Us</a>

        </div>


        <div class="footer-column">

          <h4>Contact Us</h4>

          <a
            href="https://maps.app.goo.gl/4uJSrhRj8UF7CsR88"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ibrahimpatnam (Mandal), Pocharam Rd, Vastunagar, Mangalpalli (Village), Telangana 501510
          </a>

          <a href="mailto:csicvrce@gmail.com">
            csicvrce@gmail.com
          </a>

        </div>

      </div>


      <div class="footer-bottom">

        <span>
          © {new Date().getFullYear()} CSI CVRCE
        </span>

        <span>
          Built with purpose.
        </span>

      </div>

    </footer>

  </body>
</html>