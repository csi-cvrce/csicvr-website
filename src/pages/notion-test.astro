---
import { getPublishedPosts } from "../lib/notion";

let posts = [];
let errorMessage = "";

try {
  posts = await getPublishedPosts();
} catch (error) {
  errorMessage = error instanceof Error ? error.message : "Unable to connect to Notion";
}
---

<html lang="en">
  <head>
    <title>Notion Connection Test</title>
  </head>

  <body>
    <h1>Notion Connection Test</h1>

    {errorMessage ? (
      <p>Notion connection unavailable: {errorMessage}</p>
    ) : (
      <p>Posts found: {posts.length}</p>
    )}

    {!errorMessage && (
      <ul>
        {posts.map((post) => <li>{post.title}</li>)}
      </ul>
    )}
  </body>
</html>