---

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Our Team | CSI CVRCE</title>

  <meta
    name="description"
    content="Meet the faculty coordinators and student organisers of CSI CVRCE."
  />
</head>

<body>

  <!-- NAVBAR -->

  <header class="navbar">

    <div class="nav-container">

      <a href="/" class="brand">

        <img
          src="/images/cvrlogo.png"
          alt="CVR College of Engineering Logo"
          class="cvr-logo"
        />

        <span class="divider"></span>

        <img
          src="/images/csicvrlogo.png"
          alt="CSI Logo"
          class="csi-logo"
        />

      </a>

      <nav class="desktop-nav">
        <a href="/">Home</a>
        <a href="/aboutus">About Us</a>
        <a href="/events">Events</a>
        <a href="/gallery">Gallery</a>
        <a href="/team" class="active">Team</a>
      </nav>

      <a href="/join-us" class="nav-button">
        Join Us
      </a>

      <button class="mobile-menu" aria-label="Open menu">
        ☰
      </button>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/aboutus">About Us</a>
        <a href="/events">Events</a>
        <a href="/gallery">Gallery</a>
        <a href="/team">Team</a>
        <a href="/join-us">Join Us</a>
      </nav>

    </div>

  </header>

  <script>
    const mobileMenu = document.querySelector<HTMLButtonElement>('.mobile-menu');
    const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

    mobileMenu?.addEventListener('click', () => {
      const isOpen = mobileNav?.classList.toggle('is-open') ?? false;
      mobileMenu.setAttribute('aria-expanded', String(isOpen));
      mobileMenu.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    mobileNav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileNav.classList.remove('is-open'));
    });
  </script>


  <!-- HERO -->

  <main>

    <section class="team-hero">

      <div class="hero-badge">
        <span></span>
        CSI CVRCE
      </div>

      <h1>
        Our
        <span>Team.</span>
      </h1>

      <p>
        Meet the faculty coordinators and student
        organisers driving the CSI community forward.
      </p>

    </section>


    <!-- FACULTY -->

    <section class="team-section">

      <div class="section-label">
        <span>01</span>
        FACULTY COORDINATORS
      </div>

      <div class="section-heading">

        <h2>
          Guided by
          <span>experience.</span>
        </h2>

        <p>
          Dedicated faculty members who mentor,
          guide and support the CSI Student Branch.
        </p>

      </div>


      <div class="faculty-grid">

        {faculty.map((person) => (

          <article class="faculty-card">

            <div class="faculty-image">

              <img
                src={person.image}
                alt={person.name}
                loading="lazy"
              />

            </div>

            <div class="faculty-info">

              <span class="person-number">
                FACULTY
              </span>

              <h3>
                {person.name}
              </h3>

              <strong>
                {person.role}
              </strong>

              <p>
                {person.department}
              </p>

            </div>

          </article>

        ))}

      </div>

    </section>


    <!-- STUDENT ORGANISERS -->

    <section class="team-section student-section">

      <div class="section-label">
        <span>02</span>
        STUDENT LEADERSHIP
      </div>

      <div class="section-heading">

        <h2>
          Led by
          <span>students.</span>
        </h2>

        <p>
          The student leadership team responsible for building,
          organising and growing the CSI community.
        </p>

      </div>


      <div class="student-grid">

        {studentOrganisers.map((person) => (

          <article class="student-card">

            <div class="student-image">

              {typeof person.image === "string" ? (
                <img
                  src={person.image}
                  alt={person.name}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={person.image}
                  alt={person.name}
                  width={600}
                  height={800}
                  format="webp"
                  quality={75}
                  loading="lazy"
                />
              )}

              <div class="student-index">
                +
              </div>

            </div>

            <div class="student-info">

              <h3>
                {person.name}
              </h3>

              <span>
                {person.role}
              </span>

              <div class="student-details-row">
                <small>{person.details}</small>

                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    class="student-linkedin"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View ${person.name}'s LinkedIn profile`}
                    title="View LinkedIn profile"
                  >
                    <span aria-hidden="true">in</span>
                  </a>
                )}
              </div>

            </div>

          </article>

        ))}

      </div>

    </section>


    <!-- EXECUTIVE MEMBERS -->

    <section class="team-section executive-section">

      <div class="section-label">
        <span>03</span>
        EXECUTIVE MEMBERS
      </div>

      <div class="section-heading">

        <h2>
          The wider
          <span>team.</span>
        </h2>

        <p>
          Executive members supporting the chapter's activities,
          events and community initiatives.
        </p>

      </div>

      <div class="student-grid">

        {executiveMembers.map((person) => (

          <article class="student-card">

            <div class="student-image">

              <Image
                src={person.image}
                alt={person.name}
                width={600}
                height={800}
                format="webp"
                quality={75}
                loading="lazy"
              />

              <div class="student-index">
                +
              </div>

            </div>

            <div class="student-info">

              <h3>
                {person.name}
              </h3>
              <span>{person.role}</span>
              <div class="student-details-row">
                <small>{person.details}</small>

                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    class="student-linkedin"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View ${person.name}'s LinkedIn profile`}
                    title="View LinkedIn profile"
                  >
                    <span aria-hidden="true">in</span>
                  </a>
                )}
              </div>

            </div>

          </article>

        ))}

      </div>

    </section>


    <!-- ADVISORY COMMITTEE -->

    <section class="team-section advisory-section">

      <div class="section-label">
        <span>04</span>
        ADVISORY COMMITTEE
      </div>

      <div class="section-heading">

        <h2>
          Guided by
          <span>advisors.</span>
        </h2>

        <p>
          Members of the advisory committee supporting the CSI chapter.
        </p>

      </div>

      <div class="advisory-grid">
        {advisoryCommittee.map((person) => (
          <article class="advisory-card">
            <div class="advisory-image">
              {typeof person.image === "string" ? (
                <img
                  src={person.image}
                  alt={person.name}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={person.image}
                  alt={person.name}
                  width={600}
                  height={800}
                  format="webp"
                  quality={75}
                  loading="lazy"
                />
              )}
            </div>

            <div class="advisory-info">
              <h3>{person.name}</h3>
              <div class="student-details-row">
                <p>{person.details}</p>

                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    class="student-linkedin"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View ${person.name}'s LinkedIn profile`}
                    title="View LinkedIn profile"
                  >
                    <span aria-hidden="true">in</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

    </section>


    <!-- ELECTION OFFICERS -->

    <section class="team-section officers-section">

      <div class="section-label">
        <span>05</span>
        ELECTION OFFICERS - CSI-SBCS
      </div>

      <div class="officer-list">
        {electionOfficers.map((officer, index) => (
          <div class="officer-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{officer}</strong>
          </div>
        ))}
      </div>

    </section>


    <!-- CTA -->

    <section class="team-cta">

      <div>

        <div class="hero-badge">
          <span></span>
          BE PART OF THE COMMUNITY
        </div>

        <h2>
          Ready to
          <span>lead?</span>
        </h2>

        <p>
          Join CSI CVRCE and become part of the
          next generation of technology leaders.
        </p>

        <a href="/join-us" class="primary-button">
          Join CSI
          <span>↗</span>
        </a>

      </div>

    </section>

  </main>


  <!-- FOOTER -->

  <footer>

    <div class="footer-main">

      <div class="footer-brand">

        <div class="footer-logos">

          <img
            src="/images/cvrlogo.png"
            alt="CVR College of Engineering"
          />

          <img
            src="/images/csicvrlogo.png"
            alt="CSI"
          />

        </div>

        <h3>CSI CVRCE</h3>

        <p>
          Computer Society of India - CVRCE Student
          Chapter is committed to the advancement of
          theory and practice of Computer Engineering
          and Technology Systems.
        </p>

        <div class="socials">
          <a
            href="https://www.instagram.com/csi_cvr/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
          <a
            href="https://www.linkedin.com/company/csi-cvrce/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
          <a
            href="https://github.com/csi-cvrce"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>

      </div>


      <div class="footer-column">

        <h4>Quick Links</h4>

        <a href="/">Home</a>
        <a href="/aboutus">About Us</a>
        <a href="/events">Events</a>
        <a href="/gallery">Gallery</a>
        <a href="/team">Team</a>
        <a href="/join-us">Join Us</a>

      </div>


      <div class="footer-column">

        <h4>Contact Us</h4>

        <a href="mailto:csicvrce@gmail.com">
          csicvrce@gmail.com
        </a>

        <a
          href="https://maps.app.goo.gl/4uJSrhRj8UF7CsR88"
          target="_blank"
        >
          Ibrahimpatnam (Mandal), Pocharam Rd, Vastunagar, Mangalpalli (Village), Telangana 501510
        </a>

      </div>

    </div>


    <div class="footer-bottom">

      <span>
        © {new Date().getFullYear()} CSI CVRCE
      </span>

      <span>
        Built with purpose.
      </span>

    </div>

  </footer>

</body>
</html>