const studentOrganisers = [
  {
    name: "Arjun Reddy",
    role: "Chairperson",
    image: "/images/team/PROFILE%20.jpg",
  },
  {
    name: "Meera Nair",
    role: "Vice Chairperson",
    image: "/images/team/PROFILE%20.jpg",
  },
  {
    name: "Karthik Varma",
    role: "Secretary",
    image: "/images/team/PROFILE%20.jpg",
  },
  {
    name: "Ananya Rao",
    role: "Technical Lead",
    image: "/images/team/PROFILE%20.jpg",
  },
  {
    name: "Rohan Desai",
    role: "Events Lead",
    image: "/images/team/PROFILE%20.jpg",
  },
  {
