  </main>

  <script>
    const teamSwitcherButtons = document.querySelectorAll<HTMLButtonElement>('[data-team-view]');

    teamSwitcherButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedView = button.dataset.teamView;

        if (!selectedView) return;

        teamSwitcherButtons.forEach((item) => {
          const isSelected = item === button;
          item.classList.toggle('is-active', isSelected);
          item.setAttribute('aria-selected', String(isSelected));
          item.tabIndex = isSelected ? 0 : -1;
        });

        document.querySelectorAll<HTMLElement>('.team-view').forEach((view) => {
          view.hidden = view.id !== selectedView;
        });
      });
    });
  </script>


